<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> | Wanderlust</title>
    <link rel="stylesheet" href="/css/show.css">
    <link rel="stylesheet" href="/css/delete-confirm.css">
</head>
<body>
    <header>
        <nav class="topbar" aria-label="Main navigation">
            <a class="brand" href="/listing">Wanderlust</a>
            <a class="back-link" href="/listing">Explore stays</a>
        </nav>
    </header>

    <main>
        <h1><%= listing.title %></h1>
        <p class="location">
            <%= [listing.location, listing.country].filter(Boolean).join(", ") || "Location not specified" %>
        </p>

        <img
            class="photo"
            src="<%= listing.image || 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1400' %>"
            alt="<%= listing.title %>"
        >

        <section class="details-layout" aria-label="Stay details and booking information">
            <div>
                <div class="host-summary">
                    <h2>Stay at <%= listing.title %></h2>
                    <p>Discover this place in <%= [listing.location, listing.country].filter(Boolean).join(", ") || "a destination waiting to be explored" %>.</p>
                </div>
                <p class="description"><%= listing.discription || "The host has not added a description for this stay yet." %></p>
            </div>

            <aside class="booking-card" aria-label="Price information">
                <p class="price">₹<%= Number(listing.price || 0).toLocaleString("en-IN") %> <span>night</span></p>
                <a class="edit-listing-link" href="/listing/<%= listing._id %>/edit">Edit stay details</a>
                <a href="/listing">Explore more stays</a>
                <button class="delete-listing-button" type="button" data-open-delete-dialog>
                    Delete stay
                </button>
                <p class="booking-note">Price shown is per night. Contact the host to confirm availability and reservation details.</p>
            </aside>
        </section>
    </main>
    <dialog class="delete-dialog" aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-message">
        <h2 id="delete-dialog-title">Delete this stay?</h2>
        <p id="delete-dialog-message">
            This will permanently delete <strong><%= listing.title %></strong>. This action cannot be undone.
        </p>
        <div class="delete-dialog-actions">
            <button type="button" class="cancel-delete-button" data-close-delete-dialog>Cancel</button>
            <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST">
                <button type="submit" class="confirm-delete-button">Yes, delete stay</button>
            </form>
        </div>
    </dialog>
    <script src="/js/delete-confirm.js" defer></script>
</body>
</html>
